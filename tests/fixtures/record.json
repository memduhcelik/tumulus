{
    "service": "tide-gauge",
    "version": "2.0.0-rc.1",
    "listen": {
        "host": "0.0.0.0",
        "port": 8443,
        "tls": true
    },
    "limits": {
        "max_body_bytes": 10485760,
        "rate_per_minute": 1200,
        "burst": 150.0,
        "ratio": 0.1,
        "tiny": 5e-324,
        "huge": 1.7976931348623157e+308
    },
    "ids": {
        "exact": 9007199254740993,
        "neg_zero": -0,
        "long": 123456789012345678901234567890
    },
    "labels": {
        "tr": "Şehir İçi Ölçüm",
        "jp": "潮位計",
        "emoji": "🌊 high tide",
        "escaped": "tab\tnewline\nquote\"slash\\",
        "nul": "a\u0000b"
    },
    "regions": [
        {
            "name": "north",
            "weight": 3,
            "enabled": true
        },
        {
            "name": "south",
            "weight": 0,
            "enabled": false
        },
        {
            "name": "east",
            "weight": null
        }
    ],
    "empty": {
        "obj": {},
        "arr": [],
        "str": ""
    },
    "nested": {
        "a": {
            "b": {
                "c": {
                    "d": {
                        "e": [
                            1,
                            [
                                2,
                                [
                                    3,
                                    [
                                        4,
                                        [
                                            5
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    }
                }
            }
        }
    }
}
